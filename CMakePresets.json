{
    "version": 3,
    "configurePresets": [
        {
            "name": "common-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_C_STANDARD": "99",
                "CMAKE_CXX_STANDARD": "20",
                "ENABLE_BENCHMARKS": "ON",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_LINTERS": "OFF",
                "ENABLE_SANITIZERS": "OFF",
                "ENABLE_TESTS": "ON",
                "ENABLE_WARNINGS": "ON",
                "SANITIZERS": "",
                "PROJECT_LINKER": ""
            }
        },
        {
            "name": "debug-base",
            "hidden": true,
            "inherits": "common-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_IPO": "OFF"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "common-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_IPO": "ON",
                "ENABLE_ARCH_OPTIMIZATIONS": "ON"
            }
        },
        {
            "name": "profile-base",
            "hidden": true,
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "clang-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "PROJECT_LINKER": "lld"
            }
        },
        {
            "name": "gcc-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "mingw-base",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
                "VCPKG_HOST_TRIPLET": "x64-mingw-static"
            }
        },
        {
            "name": "msvc-base",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang-debug",
            "inherits": [
                "debug-base",
                "clang-base"
            ],
            "displayName": "clang - Debug",
            "description": "Disable optimizations - include debug information."
        },
        {
            "name": "clang-profile",
            "inherits": [
                "profile-base",
                "clang-base"
            ],
            "displayName": "clang - RelWithDebInfo",
            "description": "Optimize for speed - include debug information."
        },
        {
            "name": "clang-release",
            "inherits": [
                "release-base",
                "clang-base"
            ],
            "displayName": "clang - Release",
            "description": "Optimize for speed - exclude debug information."
        },
        {
            "name": "gcc-debug",
            "inherits": [
                "debug-base",
                "gcc-base"
            ],
            "displayName": "gcc - Debug",
            "description": "Disable optimizations - include debug information."
        },
        {
            "name": "gcc-profile",
            "inherits": [
                "profile-base",
                "gcc-base"
            ],
            "displayName": "gcc - RelWithDebInfo",
            "description": "Optimize for speed - include debug information."
        },
        {
            "name": "gcc-release",
            "inherits": [
                "release-base",
                "gcc-base"
            ],
            "displayName": "gcc - Release",
            "description": "Optimize for speed - exclude debug information."
        },
        {
            "name": "mingw-debug",
            "inherits": [
                "debug-base",
                "mingw-base"
            ],
            "displayName": "mingw - Debug",
            "description": "Disable optimizations - include debug information."
        },
        {
            "name": "mingw-profile",
            "inherits": [
                "profile-base",
                "mingw-base"
            ],
            "displayName": "mingw - RelWithDebInfo",
            "description": "Optimize for speed - include debug information."
        },
        {
            "name": "mingw-release",
            "inherits": [
                "release-base",
                "mingw-base"
            ],
            "displayName": "mingw - Release",
            "description": "Optimize for speed - exclude debug information."
        },
        {
            "name": "msvc-debug",
            "inherits": [
                "debug-base",
                "msvc-base"
            ],
            "displayName": "msvc - Debug",
            "description": "Disable optimizations - include debug information."
        },
        {
            "name": "msvc-profile",
            "inherits": [
                "profile-base",
                "msvc-base"
            ],
            "displayName": "msvc - RelWithDebInfo",
            "description": "Optimize for speed - include debug information."
        },
        {
            "name": "msvc-release",
            "inherits": [
                "release-base",
                "msvc-base"
            ],
            "displayName": "msvc - Release",
            "description": "Optimize for speed - exclude debug information."
        }
    ]
}
